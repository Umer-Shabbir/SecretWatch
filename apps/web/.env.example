# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/secretwatch"

# Auth.js — admin sign-in only (email+password Credentials provider). No
# end-user accounts and no GitHub OAuth login exist in this product.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AES-256-GCM key for encrypting stored GitHub PATs at rest (M03). 32-byte key, base64-encoded.
TOKEN_ENCRYPTION_KEY=""

# One-time admin bootstrap (prisma/seed.ts). Unset after first run.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Redis connection for BullMQ queues (M04 Scanner + Findings). Use a local
# redis:// URL for dev, or an Upstash rediss:// TLS URL in production.
# Consumed by apps/worker (scanner + scheduler); shared queue name constants
# live in packages/shared/src/queue.ts.
REDIS_URL="redis://localhost:6379"

# Scheduler tick interval in minutes (apps/worker/src/scheduler.ts). Optional —
# defaults to 15 if unset. Keep conservative to respect GitHub's authenticated
# code search rate limit (~30 req/min).
SCAN_INTERVAL_MINUTES="15"
